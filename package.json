{
  "name": "opencoode",
  "version": "1.4.0",
  "private": true,
  "packageManager": "pnpm@12.16.1",
  "main": "index.ts",
  "scripts": {
    "start": "expo start --max-workers 2",
    "android": "expo start --android --max-workers 2",
    "ios": "node scripts/ios.mjs",
    "web": "expo start --web --max-workers 2",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "export": "expo export --platform all --max-workers 2",
    "test:live": "tsx tests/live-server.ts",
    "terminal:bundle": "node scripts/bundle-terminal.mjs",
    "sim:slim": "node scripts/ios.mjs --slim-only",
    "test:inference": "tsx tests/live-inference.ts"
  },
  "dependencies": {
    "@opencode/client": "2.2.5",
    "@react-navigation/elements": "^2.9.45",
    "@react-navigation/native": "^7.5.1",
    "@react-navigation/native-stack": "^7.21.0",
    "@shopify/flash-list": "2.3.3",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "expo": "~58.0.21",
    "expo-build-properties": "~58.0.11",
    "expo-camera": "~58.0.14",
    "expo-clipboard": "~58.0.4",
    "expo-document-picker": "~58.0.4",
    "expo-file-system": "~58.0.13",
    "expo-font": "~58.0.11",
    "expo-secure-store": "~58.0.2",
    "expo-sharing": "~58.0.21",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "jsonc-parser": "^3.3.1",
    "markdown-it": "^15.0.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-native": "0.88.1",
    "react-native-keyboard-controller": "1.22.9",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.0",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.4",
    "react-native-webview": "14.0.1",
    "react-native-worklets": "0.13.1"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^26.6.6",
    "@types/react": "~19.3.0",
    "tsx": "^4.20.6",
    "typescript": "~7.0.0"
  },
  "type": "module",
  "engines": {
    "node": "^22.13.0 || ^24.3.0 || >=26.0.0"
  }
